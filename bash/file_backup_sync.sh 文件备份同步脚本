#!/bin/bash
# Local file backup sync script
# 中文说明：本地目录增量备份，使用rsync，记录备份日志
# Personal practice, for learning only

# Configurations | 配置项
SRC_DIR="/opt/app/data"
DST_DIR="/opt/backup"
LOG_DIR="/var/ops_log"
LOG_FILE="${LOG_DIR}/backup_$(date +%Y%m%d).log"
mkdir -p ${LOG_DIR}
mkdir -p ${DST_DIR}

TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")
echo "[${TIMESTAMP}] Start file backup | 开始文件备份" >> ${LOG_FILE}

rsync -av --delete ${SRC_DIR}/ ${DST_DIR}/ >> ${LOG_FILE} 2>&1

if [ $? -eq 0 ];then
    echo "[${TIMESTAMP}] Backup SUCCESS | 备份成功" >> ${LOG_FILE}
else
    echo "[${TIMESTAMP}] Backup FAILED | 备份失败" >> ${LOG_FILE}
fi
echo "" >> ${LOG_FILE}
